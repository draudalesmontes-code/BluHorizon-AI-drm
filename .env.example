# Copy this to .env and replace placeholder values.
ANTHROPIC_API_KEY=replace_me
TAVILY_API_KEY=replace_me
POSTGRES_PASSWORD=local_dev_password

# For local host tests/evals. Uses 55432 to avoid conflicts with macOS Postgres.
DATABASE_URL=postgresql://postgres:local_dev_password@127.0.0.1:55432/bluhorizon

# docker-compose maps this into DATABASE_URL for the API container.
DOCKER_DATABASE_URL=postgresql://postgres:local_dev_password@db:5432/bluhorizon

SECRET_KEY=replace_me_with_any_long_random_string
CLAUDE_MODEL=claude-haiku-4-5
MAX_TOKENS=4096
FAISS_INDEX_PATH=./faiss_data
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
