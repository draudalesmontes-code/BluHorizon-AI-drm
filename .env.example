# Copy this to .env and replace placeholder values.
ANTHROPIC_API_KEY=replace_me
TAVILY_API_KEY=replace_me

# For local host tests/evals:
DATABASE_URL=postgresql://postgres:Oreoboy4@localhost:5432/bluhorizon

# For API container inside docker compose, use this DATABASE_URL instead:
# DATABASE_URL=postgresql://postgres:Oreoboy4@db:5432/bluhorizon

SECRET_KEY=replace_me_with_any_long_random_string
CLAUDE_MODEL=claude-haiku-4-5
MAX_TOKENS=4096
FAISS_INDEX_PATH=./faiss_data
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
